<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/register_subtitle"
            android:textColor="#475569"
            android:layout_marginTop="6dp" />

        <!-- Full Name -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_full_name"
            android:inputType="textPersonName"
            android:layout_marginTop="16dp" />

        <!-- Gender -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_gender"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginTop="14dp" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gender_male" />

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gender_female" />

            <RadioButton
                android:id="@+id/rbNonBinary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gender_non_binary" />

            <RadioButton
                android:id="@+id/rbOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gender_other" />
        </RadioGroup>

        <!-- Other gender -->
        <EditText
            android:id="@+id/etOtherGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_other_gender"
            android:visibility="gone"
            android:layout_marginTop="6dp" />

        <!-- Year -->
        <EditText
            android:id="@+id/etYearOfBirth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_year"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <!-- Username -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_choose_member_id"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_create_password"
            android:inputType="textPassword"
            android:layout_marginTop="12dp" />

        <!-- Re-enter Password -->
        <EditText
            android:id="@+id/etPassword2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_reenter_password"
            android:inputType="textPassword"
            android:layout_marginTop="10dp" />

        <!-- Register button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_create_membership"
            android:layout_marginTop="16dp" />

        <!-- Message -->
        <TextView
            android:id="@+id/txtRegisterMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B00020"
            android:layout_marginTop="10dp" />

        <!-- ✅ Back to Login button -->
        <Button
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Login"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
